# Copy to .env and adjust. Every value has a sensible default in docker-compose.yml.
# ENVIRONMENT=production refuses to start with the insecure default secrets below
# or with DEMO_LOGINS on.
ENVIRONMENT=local
# One-click account switcher in the web UI (passwordless login). Local demos only.
DEMO_LOGINS=true

POSTGRES_USER=takeaway
POSTGRES_PASSWORD=takeaway
POSTGRES_DB=takeaway
POSTGRES_PORT=5432

HTTP_PORT=8080

JWT_SECRET_KEY=insecure-dev-secret-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

FIRST_ADMIN_EMAIL=admin@takeaway.dev
FIRST_ADMIN_PASSWORD=admin1234
MAX_ORDERS_PER_CUSTOMER=10
SEED_DEMO_DATA=true
DEMO_CUSTOMER_EMAIL=customer@takeaway.dev
DEMO_CUSTOMER_PASSWORD=customer1234
